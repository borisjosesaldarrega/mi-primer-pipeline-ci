{
  "editor.detectIndentation": false,
  "editor.guides.highlightActiveIndentation": true,
  "editor.guides.indentation": true,
  "editor.insertSpaces": true,
  "editor.tabSize": 2,
  "files.associations": {
    "*.yml": "yaml",
    "*.yaml": "yaml"
  },
  "yaml.format.enable": true,
  "yaml.validate": true
}
